# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 读超时秒数（DeepSeek 有时响应慢；默认 30 秒改为 60）
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRY=3

# ===== 钉钉自定义机器人 =====
# Webhook 完整地址（含 access_token）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxx
# 加签密钥（若机器人开启加签则填写，否则留空）
DINGTALK_SECRET=
# @人手机号，多个用逗号分隔；为空表示不@
DINGTALK_AT_MOBILES=
DINGTALK_AT_ALL=false

# ===== 选股范围 =====
# 实时行情数据源: auto(默认,东财→新浪 自动回退) / em(只东财) / sina(只新浪)
SPOT_SOURCE=auto
# 成交额前 N
TOP_N_TURNOVER=100
# 同花顺热榜前 N
TOP_N_HOT=100
# 热榜单源接口超时秒数（防止某个源阻塞导致流程看起来卡死）
HOT_SOURCE_TIMEOUT=8
EXCLUDE_PREFIXES=688,920,83,87,88
EXCLUDE_NAME_KEYWORDS=ST,*ST,退

# ===== HTML 报告 / 钉钉推送 =====
# 报告对外可访问的根 URL（HTML 文件需要由 Web 服务器映射到 REPORTS_DIR）
# 例：你的 Nginx 把 /home/yyf/DailyStock/reports 映射到 http://your.host/reports
REPORT_HOST=http://your.host/reports
REPORTS_DIR=./reports
# 推送名单：AI 评分前 N (与重点票合并去重)
PUSH_TOP_N=5

# ===== 策略开关 =====
STRAT_RISK_ENABLED=true        # 硬过滤：ST/退/价格异常
STRAT_VETO_STAGNATION_ENABLED=true   # 一票否决：高位滞涨
STRAT_VETO_BIAS_ENABLED=true         # 一票否决：乖离率过大
STRAT_MA_ENABLED=true          # 均线交叉/多头排列
STRAT_MACD_ENABLED=true        # MACD 金叉/柱状转正
STRAT_RSI_ENABLED=true         # RSI 区间
STRAT_BREAKOUT_ENABLED=true    # 突破近20日高点
STRAT_PATTERN_ENABLED=true     # K线形态(双底/排除头肩顶)
STRAT_VOLUME_ENABLED=true      # 放量
STRAT_PCT_ENABLED=true         # 涨跌幅区间
STRAT_LIQUIDITY_ENABLED=true   # 流动性/振幅
STRAT_MACD_PULLBACK_ENABLED=true   # MACD底部启动→缩量回调→今日阳线放量金叉组合信号

# ===== 一票否决阈值 =====
# 高位滞涨
VETO_STAGNATION_PCT_20D=30.0           # 20日累计涨幅超过此值视为高位 (%)
VETO_STAGNATION_NEAR_52W=0.10          # 距52周高点小于此比例也视为高位
VETO_STAGNATION_VOL_RATIO=2.0          # 当日量/5日均量 大于此值视为天量
VETO_STAGNATION_PCT_TODAY=2.0          # 今日涨幅小于此值视为滞涨 (%)
VETO_STAGNATION_UPPER_SHADOW=3.0       # (high-close)/close 大于此值也视为滞涨 (%)
# 乖离率过大
VETO_BIAS10=15.0                       # close 高于 MA10 超过 % 则否决
VETO_BIAS20=20.0                       # close 高于 MA20 超过 % 则否决

# ===== 信号策略阈值 =====
VOLUME_RATIO_MIN=1.2
PCT_MIN=-3.0
PCT_MAX=7.0
TURNOVER_FLOOR=200000000
AMPLITUDE_CAP=15.0
# 至少命中多少个信号策略才进入候选池（不含硬过滤）
MIN_SIGNALS=2

# ===== MACD_PULLBACK 组合策略阈值 =====
# 在多少天的 lookback 内查找底部金叉
MACD_PULLBACK_LOOKBACK=60
# 启动段 hist 递增红柱最少几根（小红→大红）
MACD_PULLBACK_IMPULSE_MIN=2
# 回调段最少几根
MACD_PULLBACK_MIN=2
# 回调段最多几根（超出视为形态过期）
MACD_PULLBACK_MAX=20
# 回调期平均量 / 启动期平均量 <= 该比例 才算缩量
MACD_PULLBACK_SHRINK_RATIO=0.85

# ===== AI 决策阈值 =====
FOCUS_SCORE=80
TOP_K_FOCUS=10
# 对候选池调用 DeepSeek 的安全上限（0=全部调；建议改 5-10 避免过载超时）
AI_MAX_CANDIDATES=5
# DeepSeek 并发 worker 数（建议 2-4；太高容易触发超时）
AI_WORKERS=3

# ===== K线 缓存 / 并发 =====
KLINES_CACHE_ENABLED=true
KLINES_CACHE_DIR=./data/klines
KLINES_DAYS=250
KLINES_WORKERS=6

# ===== 大盘 / 行业 / 一字板 过滤 =====
MARKET_FILTER_ENABLED=true
# 大盘弱势(上证<MA20)时，仅推送 AI 分>=该值的票
MARKET_FILTER_MIN_SCORE=90
# 选股池小于该值时直接中止（视为数据源异常）
UNIVERSE_MIN_SIZE=50
# 推送时剔除涨停票（包含一字板；历史键 YIZIBAN_FILTER_ENABLED 仍兼容）
LIMIT_UP_FILTER_ENABLED=true
# 价格上限（0=不限）。一手=100 股，价格太高买不起。例如 50 → 一手最多 5000 元
MAX_PRICE=0
# 行业去集中：同一行业最多 N 只
INDUSTRY_DIVERSIFY_ENABLED=true
INDUSTRY_MAX_PER_INDUSTRY=2
INDUSTRY_CACHE_PATH=./data/industry_map.json
INDUSTRY_CACHE_TTL_DAYS=7

# ===== 推送跟踪 / 报告 =====
TRACKING_ENABLED=true
TRACKING_LOOKBACK_DAYS=30
# 报告中是否嵌入 ECharts K 线小图
REPORT_KLINE_CHART=true

# ===== 邮件兜底（钉钉故障时） =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
# 多个收件人逗号分隔
SMTP_RECIPIENTS=
SMTP_USE_SSL=true

# ===== 存储 =====
DATA_DIR=./data
SQLITE_PATH=./data/dailystock.db

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=./logs
